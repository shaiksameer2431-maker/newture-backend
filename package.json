{
  "name": "necn-nexa-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18 <=22"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "node scripts/build.cjs",
    "start": "node dist/server.cjs",
    "backup-db": "node scripts/database/backup-db.js",
    "migrate:canonical-db": "node scripts/database/migrate-canonical-db.mjs",
    "rebuild-kb": "tsx scripts/rag/rebuild-knowledge-base.ts",
    "ingest:necn": "tsx scripts/crawling/ingest-necn.ts",
    "reprocess:pdfs": "tsx scripts/extraction/reprocess-failed-pdfs.ts",
    "test-retrieval": "tsx scripts/rag/test-retrieval.ts",
    "test:pdf": "tsx tests/test_pdf_extractor_suite.ts",
    "test:acceptance": "tsx tests/test_acceptance_suite.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "setup": "npm install --no-audit --no-fund",
    "predev": "npm run setup",
    "prebuild": "npm run setup"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "necn-nexa-backend": "file:",
    "nodemailer": "^9.0.5",
    "onnxruntime-node": "^1.18.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
