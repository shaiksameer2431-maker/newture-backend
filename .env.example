# ============================================================================
# NECN NEXA BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy to .env for local environment configuration.
# ============================================================================

NODE_ENV=production
PORT=3000

# SQLite Database & Storage
DATABASE_PATH=data/necn.db
MODEL_PATH=models

# Server Network & CORS Setup
FRONTEND_URL=https://your-frontend.up.railway.app
CORS_ORIGINS=http://localhost:5173,https://your-frontend.up.railway.app

# Initial Administrator Credentials (Set before first startup)
ADMIN_EMAIL=admin@necn.ac.in
ADMIN_INITIAL_PASSWORD=ChangeMeNow123!
